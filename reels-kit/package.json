{
  "name": "reels-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion ile ham videoyu animasyonlu altyazılı, kamera hareketli, markalı 9:16 reels'e çeviren şablon.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "prepare-reel": "node scripts/prepare.mjs",
    "render": "remotion render src/index.ts Reel out/reel.mp4 --codec=h264 --crf=18",
    "still": "remotion still src/index.ts Reel out/still.png --frame=60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/media-utils": "4.0.529",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.7.2"
  }
}
